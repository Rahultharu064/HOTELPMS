generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Room Types
model RoomType {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  image       String?  @db.VarChar(500)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms   Room[]
  reviews Review[]

  @@map("room_types")
}

// Rooms
model Room {
  id          Int        @id @default(autoincrement())
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(150)
  roomNumber  String     @unique @db.VarChar(20)
  roomTypeId  Int
  capacity    Int        @default(2)
  basePrice   Decimal    @db.Decimal(10, 2)
  floor       Int?
  status      RoomStatus @default(available)
  description String?    @db.Text
  size        Int?
  bedType     BedType?   @default(double)
  view        String?    @db.VarChar(100)
  isFeatured  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roomType         RoomType          @relation(fields: [roomTypeId], references: [id], onDelete: Restrict)
  images           Image[]
  videos           Video[]
  bookings         Booking[]
  amenities        Amenity[]         @relation("RoomAmenities")
  serviceOrders    ServiceOrder[]
  housekeepingLogs HousekeepingLog[]

  @@index([status])
  @@index([roomTypeId])
  @@index([isFeatured])
  @@map("rooms")
}

// Amenities
model Amenity {
  id          Int             @id @default(autoincrement())
  name        String          @unique @db.VarChar(100)
  icon        String?         @db.VarChar(255)
  category    AmenityCategory @default(standard)
  description String?         @db.Text
  createdAt   DateTime        @default(now())

  rooms Room[] @relation("RoomAmenities")

  @@map("amenities")
}

// Images
model Image {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  alt       String?  @db.VarChar(255)
  roomId    Int?
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("images")
}

// Videos
model Video {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  title     String?  @db.VarChar(255)
  thumbnail String?  @db.VarChar(500)
  roomId    Int?
  createdAt DateTime @default(now())

  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId])
  @@map("videos")
}

// Bookings
model Booking {
  id              Int           @id @default(autoincrement())
  bookingNumber   String        @unique @db.VarChar(50)
  guestId         Int
  roomId          Int
  checkIn         DateTime
  checkOut        DateTime
  adults          Int           @default(1)
  children        Int           @default(0)
  totalAmount     Decimal       @db.Decimal(10, 2)
  status          BookingStatus @default(pending)
  source          BookingSource @default(direct)
  specialRequests String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  guest         Guest                 @relation(fields: [guestId], references: [id])
  room          Room                  @relation(fields: [roomId], references: [id])
  payments      Payment[]
  workflowLogs  BookingWorkflowLog[]
  serviceOrders ServiceOrder[]
  extraServices BookingExtraService[]
  review        Review?

  // Composite indexes below subsume the single-column lookups they replace (MySQL can use
  // a composite index's leftmost prefix for a query on just that first column), so a
  // guestId-only or roomId-only or status-only filter is still served — these just also
  // cover the far more common combined filters actually used across the app (a guest's
  // active bookings, a room's conflicting bookings, the admin's "pending bookings" list
  // sorted by recency, etc.) without needing a second, redundant single-column index.
  @@index([guestId, status])
  @@index([roomId, status])
  @@index([status, createdAt])
  @@index([checkIn, checkOut])
  // checkIn/checkOut above only serves checkIn-led range scans (leftmost-prefix rule) —
  // "today's departures" filters on checkOut alone and needs its own index to avoid a
  // full table scan.
  @@index([checkOut])
  @@map("bookings")
}

// Extra Services
model ExtraService {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(100)
  description        String?  @db.Text
  price              Decimal  @db.Decimal(10, 2)
  categoryId         Int
  image              String?  @db.VarChar(500)
  discountPercentage Float    @default(0)
  discountAllowed    Boolean  @default(false)
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  category ServiceCategory       @relation(fields: [categoryId], references: [id])
  bookings BookingExtraService[]

  // Backs the public "extra services" listing: active items, newest first.
  @@index([active, createdAt])
  @@map("extra_services")
}

// Booking Extra Services (Link table)
model BookingExtraService {
  id                  Int      @id @default(autoincrement())
  bookingId           Int
  extraServiceId      Int
  quantity            Int      @default(1)
  unitPrice           Decimal  @db.Decimal(10, 2)
  basePrice           Decimal  @db.Decimal(10, 2)
  discountAmount      Decimal  @default(0) @db.Decimal(10, 2)
  serviceChargeAmount Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice          Decimal  @db.Decimal(10, 2)
  createdAt           DateTime @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraService ExtraService @relation(fields: [extraServiceId], references: [id])

  @@index([bookingId])
  @@index([extraServiceId])
  @@map("booking_extra_services")
}

// App Settings
model AppSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.Text
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

// Guests
model Guest {
  id           Int     @id @default(autoincrement())
  email        String  @unique @db.VarChar(255)
  phone        String? @unique @db.VarChar(20)
  password     String? @db.VarChar(255)
  firstName    String  @db.VarChar(100)
  lastName     String  @db.VarChar(100)
  address      String? @db.Text
  city         String? @db.VarChar(100)
  country      String? @db.VarChar(100)
  postalCode   String? @db.VarChar(20)
  idType       IdType? @default(passport)
  idNumber     String? @db.VarChar(100)
  idProofImage String? @db.VarChar(500)
  profileImage String? @db.VarChar(500)

  // Auth fields
  googleId          String?   @unique @db.VarChar(255)
  otp               String?   @db.VarChar(10)
  otpExpires        DateTime?
  resetToken        String?   @db.VarChar(255)
  resetTokenExpires DateTime?
  isVerified        Boolean   @default(false)

  totalBookings Int      @default(0)
  totalSpent    Decimal  @default(0) @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bookings      Booking[]
  reviews       Review[]
  serviceOrders ServiceOrder[]

  // No separate [email]/[phone] indexes — @unique above already creates one for each;
  // a second plain index on the same column is pure redundancy (extra write cost, zero
  // read benefit, since the unique index already serves lookups and range scans).
  // createdAt and totalSpent back real admin queries: "new guests this month" (count by
  // createdAt range) and the "top guests by spend" widget (order by totalSpent, limit 10).
  @@index([createdAt])
  @@index([totalSpent])
  @@map("guests")
}

// Admins & Staff
model Admin {
  id                 Int       @id @default(autoincrement())
  email              String    @unique @db.VarChar(255)
  password           String    @db.VarChar(255)
  name               String    @db.VarChar(100)
  phoneNumber        String?   @db.VarChar(20)
  avatar             String?   @db.Text
  role               AdminRole @default(admin)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLogin          DateTime?
  loginAttempts      Int       @default(0)
  lockedUntil        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("admins")
}

// Admin Roles
enum AdminRole {
  superadmin
  admin
  manager
  front_office
  housekeeping

  @@map("admin_role")
}

// Payments
model Payment {
  id             Int           @id @default(autoincrement())
  bookingId      Int?
  serviceOrderId Int?
  amount         Decimal       @db.Decimal(10, 2)
  method         PaymentMethod
  status         PaymentStatus @default(pending)
  transactionId  String?       @db.VarChar(255)
  paymentData    Json?         @db.Json
  createdAt      DateTime      @default(now())

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@index([serviceOrderId])
  // Replaces a plain [status] index — every status-filtered payment query (completed
  // payments for revenue reports, the admin dashboard's "today's revenue" sum) also
  // sorts by createdAt, and the leftmost-prefix rule means this still serves a
  // status-only filter just as well.
  @@index([status, createdAt])
  @@map("payments")
}

// Booking Workflow Logs
model BookingWorkflowLog {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  action      String   @db.VarChar(100)
  description String?  @db.Text
  performedBy String?  @db.VarChar(100)
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("booking_workflow_logs")
}

// Facilities
model Facility {
  id             Int              @id @default(autoincrement())
  name           String           @unique @db.VarChar(100)
  slug           String           @unique @db.VarChar(100)
  description    String?          @db.Text
  status         FacilityStatus   @default(active)
  openingHours   String?          @db.VarChar(255)
  category       FacilityCategory @default(other)
  location       String?          @db.VarChar(255)
  plannedUpgrade String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  images FacilityImage[]
  videos FacilityVideo[]

  @@map("facilities")
}

// Facility Images
model FacilityImage {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(500)
  alt        String?  @db.VarChar(255)
  facilityId Int
  isPrimary  Boolean  @default(false)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("facility_images")
}

// Facility Videos
model FacilityVideo {
  id         Int      @id @default(autoincrement())
  url        String   @db.VarChar(500)
  title      String?  @db.VarChar(255)
  thumbnail  String?  @db.VarChar(500)
  facilityId Int
  createdAt  DateTime @default(now())

  facility Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@index([facilityId])
  @@map("facility_videos")
}

// Service Categories (Service Types)
model ServiceCategory {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  description String?       @db.Text
  image       String?       @db.VarChar(500)
  icon        String?       @db.VarChar(255)
  status      ServiceStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  services      Service[]
  extraServices ExtraService[]

  @@map("service_categories")
}

// Services (Individual Service Items)
model Service {
  id          Int           @id @default(autoincrement())
  name        String        @db.VarChar(100)
  slug        String        @unique @db.VarChar(100)
  categoryId  Int
  price       Decimal       @db.Decimal(10, 2)
  description String?       @db.Text
  image       String?       @db.VarChar(500)
  status      ServiceStatus @default(active)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category   ServiceCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  orderItems ServiceOrderItem[]

  @@index([categoryId])
  @@map("services")
}

// Service Orders
model ServiceOrder {
  id          Int                @id @default(autoincrement())
  orderNumber String             @unique @db.VarChar(50)
  bookingId   Int?
  guestId     Int?
  roomId      Int?
  totalAmount Decimal            @default(0) @db.Decimal(10, 2)
  status      ServiceOrderStatus @default(pending)
  priority    ServicePriority    @default(normal)
  notes       String?            @db.Text
  requestedBy String?            @db.VarChar(100)
  assignedTo  String?            @db.VarChar(100)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  booking  Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  guest    Guest?             @relation(fields: [guestId], references: [id], onDelete: SetNull)
  room     Room?              @relation(fields: [roomId], references: [id])
  items    ServiceOrderItem[]
  payments Payment[]

  @@index([bookingId])
  @@index([guestId])
  @@index([roomId])
  // Replaces a plain [status] index — the operations queue always lists orders by
  // status (pending/in_progress/etc.) sorted most-recent-first.
  @@index([status, createdAt])
  @@map("service_orders")
}

// Service Order Items
model ServiceOrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  serviceId Int
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)
  notes     String? @db.Text

  order   ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
  @@map("service_order_items")
}

// Enums
enum ServiceStatus {
  active
  inactive
  maintenance

  @@map("service_status")
}

enum ServiceOrderStatus {
  pending
  confirmed
  in_progress
  completed
  cancelled

  @@map("service_order_status")
}

enum ServicePriority {
  low
  normal
  high
  urgent

  @@map("service_priority")
}

enum RoomStatus {
  available
  occupied
  maintenance
  cleaning
  reserved
  out_of_service

  @@map("room_status")
}

enum BedType {
  single
  double
  queen
  king
  twin

  @@map("bed_type")
}

enum AmenityCategory {
  standard
  premium
  accessible

  @@map("amenity_category")
}

enum BookingStatus {
  pending
  confirmed
  checked_in
  checked_out
  cancelled
  no_show

  @@map("booking_status")
}

enum BookingSource {
  direct
  ota
  walk_in
  corporate

  @@map("booking_source")
}

enum PaymentMethod {
  cash
  esewa
  khalti

  @@map("payment_method")
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded

  @@map("payment_status")
}

enum IdType {
  passport
  driving_license
  national_id
  citizenship
  other

  @@map("id_type")
}

// Housekeeping Logs
model HousekeepingLog {
  id        Int              @id @default(autoincrement())
  roomId    Int
  staffId   String?          @db.VarChar(100)
  type      HousekeepingType @default(general)
  status    String           @db.VarChar(50) // e.g. clean, dirty, inspected
  notes     String?          @db.Text
  createdAt DateTime         @default(now())

  room Room @relation(fields: [roomId], references: [id])

  // Replaces a plain [roomId] index — the housekeeping board loads every room's single
  // most recent log (`orderBy: createdAt desc, take: 1`) on every refresh; a composite
  // index lets that be an index range scan per room instead of scanning all of a room's
  // history and sorting in memory.
  @@index([roomId, createdAt])
  @@map("housekeeping_logs")
}

enum HousekeepingType {
  general
  deep_clean
  inspection
  maintenance
  turn_down

  @@map("housekeeping_type")
}

// Reviews
model Review {
  id         Int          @id @default(autoincrement())
  guestId    Int
  bookingId  Int?         @unique
  roomTypeId Int?
  rating     Int          @default(5)
  comment    String?      @db.Text
  proofImage String?      @db.VarChar(500)
  staffReply String?      @db.Text
  status     ReviewStatus @default(pending)
  isVerified Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  guest    Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  booking  Booking?  @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  roomType RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: SetNull)

  @@index([guestId])
  // [roomTypeId, status] replaces a plain [roomTypeId] index (redundant once this exists,
  // per the leftmost-prefix rule) and is the exact shape of the app's single busiest
  // review query: every public room-detail and guest-favorites page load aggregates
  // approved reviews for a room type via `where: { roomTypeId, status: 'approved' }`.
  @@index([roomTypeId, status])
  // Backs the admin moderation queue: filter by status, most recent first.
  @@index([status, createdAt])
  @@map("reviews")
}

enum ReviewStatus {
  pending
  approved
  rejected
  hidden

  @@map("review_status")
}

enum FacilityStatus {
  active
  maintenance
  closed

  @@map("facility_status")
}

enum FacilityCategory {
  restaurant
  pool
  gym
  spa
  business_center
  parking
  other

  @@map("facility_category")
}

// Housekeeping Staff
model HousekeepingStaff {
  id        Int      @id @default(autoincrement())
  staffId   String   @unique @db.VarChar(50)
  name      String   @db.VarChar(100)
  role      String?  @db.VarChar(100)
  phone     String?  @db.VarChar(20)
  status    String   @default("on_duty") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("housekeeping_staff")
}

// Gallery / Venues (public website)
enum VenueLayout {
  featured
  compact
  wide

  @@map("venue_layout")
}

model GalleryVenue {
  id          Int         @id @default(autoincrement())
  title       String      @db.VarChar(150)
  slug        String      @unique @db.VarChar(180)
  description String      @db.Text
  image       String      @db.VarChar(500)
  icon        String      @default("UtensilsCrossed") @db.VarChar(50)
  layout      VenueLayout @default(compact)
  sortOrder   Int         @default(0)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([isActive])
  @@index([sortOrder])
  @@index([layout])
  @@map("gallery_venues")
}
